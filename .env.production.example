APP_NAME=SchoolSafe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://schoolsafe.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolsafe
DB_USERNAME=schoolsafe
DB_PASSWORD=replace-with-secure-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_TABLE=sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=schoolsafe

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@schoolsafe.example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ASSET_URL=

BIOMETRIC_CONSENT_VERSION=v1
BIOMETRIC_MODEL_NAME=human-hse-faceres
BIOMETRIC_MIN_QUALITY_SCORE=0.75
BIOMETRIC_MIN_SIMILARITY=0.60
BIOMETRIC_MIN_MARGIN=0.05
BIOMETRIC_PROBE_SAMPLES=3
BIOMETRIC_PROBE_DELAY_MS=550
BIOMETRIC_MIN_FRAME_QUALITY=0.50
BIOMETRIC_CHALLENGE_TTL_SECONDS=45
BIOMETRIC_VERIFY_COOLDOWN_SECONDS=5
BIOMETRIC_MAX_FAILED_ATTEMPTS=5
BIOMETRIC_FAILED_ATTEMPT_DECAY_SECONDS=300
BIOMETRIC_CHALLENGE_RATE_LIMIT=20
BIOMETRIC_VERIFICATION_RATE_LIMIT=30
BIOMETRIC_BIND_CONFIRMATION_TO_SESSION=true
BIOMETRIC_PICKUP_CONFIRMATION_WINDOW_SECONDS=300
BIOMETRIC_GATE_CANCELLATION_WINDOW_SECONDS=900
BIOMETRIC_AUDIT_RETENTION_DAYS=365
BIOMETRIC_AUDIT_STORE_IP=true
BIOMETRIC_AUDIT_STORE_USER_AGENT=true

SCHOOLSAFE_DEMO_PASSWORD=change-me
